# Server bindings only. Copy to local .dev.vars only when authorized.
# Never add real credentials to source control or NEXT_PUBLIC_/VITE_ variables.
CREATOR_EMAIL=owner@example.invalid
GODMODE_LIVE_ENABLED=false
# A writer gate, not proof that a background schedule exists. Confirm owner-private Site first.
GODMODE_BACKGROUND_ENABLED=false
# Required before live mode; positive integer microdollars, maximum 110000000.
# Deliberately unset until verified event credits and spending authorization exist.
# GODMODE_PROJECT_BUDGET_MICRO_USD=
# MODEL_API_KEY remains absent until separately authorized Meta account/credit setup.
# MODEL_API_KEY=
# D1 binding DB is configured by the workspace hosting configuration.

# Temporary local rule interpretation only; no downloads or hosted provider fallback.
# Requires npm run dev, existing loopback Ollama and the already-installed tag.
GODMODE_LOCAL_QWEN_ENABLED=false
GODMODE_LOCAL_QWEN_MODEL=qwen3.5:9b
# Fixed server-only destination: http://127.0.0.1:11434. No OLLAMA_ORIGINS change.
# NPC plans and all Meta gates remain unchanged/off.

# Optional resident-origin decisions: separate local-only opt-in; never calls Meta.
GODMODE_LOCAL_INITIATIVE_ENABLED=false

# Muse paths are implemented but access/credits are NOT verified; keep gates off.
# Explicit selection after separate verified access/credit authorization only:
# GODMODE_COZY_PROVIDER=meta
GODMODE_META_CREDIT_AUTHORIZED=false
GODMODE_RULE_AUTHORING_ENABLED=false
GODMODE_RESIDENT_REASONING_ENABLED=false
# Existing per-save $3/500generation/1000HTTP caps and project cap remain enforced.
# No runtime Muse Image route or automatic generated-asset registration is enabled.
