# Server bindings only. Copy to local .dev.vars only when authorized.
# Never add real credentials to source control or NEXT_PUBLIC_/VITE_ variables.
CREATOR_EMAIL=owner@example.invalid
GODMODE_LIVE_ENABLED=false
# A writer gate, not proof that a background schedule exists. Confirm owner-private Site first.
GODMODE_BACKGROUND_ENABLED=false
# Required before live mode; positive integer microdollars, maximum 110000000.
# Deliberately unset until verified event credits and spending authorization exist.
# GODMODE_PROJECT_BUDGET_MICRO_USD=
# MODEL_API_KEY remains absent until separately authorized Meta account/credit setup.
# MODEL_API_KEY=
# D1 binding DB is configured by the workspace hosting configuration.
